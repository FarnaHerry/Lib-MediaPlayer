<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MediaPlayer Preview" Manufacturer="org.huxerui.lib.mediaplayer.preview" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
           UpgradeCode="@HUXERUI_WINDOWS_MSI_UPGRADE_CODE@" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MediaPlayer Preview is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ApplicationIcon" SourceFile="!(bindpath.Project)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MediaPlayer Preview" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONPROGRAMMENU" Name="MediaPlayer Preview" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Application)\**" />
    </ComponentGroup>
    <Component Id="ApplicationShortcut" Directory="APPLICATIONPROGRAMMENU">
      <Shortcut Id="ApplicationStartMenuShortcut" Name="MediaPlayer Preview"
                Target="[INSTALLFOLDER]example_mediaplayer.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ApplicationIcon" />
      <RemoveFolder Id="RemoveApplicationProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\org.huxerui.lib.mediaplayer.preview\MediaPlayer Preview" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ApplicationDesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="ApplicationDesktopShortcutLink" Name="MediaPlayer Preview"
                Target="[INSTALLFOLDER]example_mediaplayer.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ApplicationIcon" />
      <RegistryValue Root="HKLM" Key="Software\org.huxerui.lib.mediaplayer.preview\MediaPlayer Preview" Name="desktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Application" Title="MediaPlayer Preview" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAbsent="yes">
      <Level Value="1" Condition="CREATE_DESKTOP_SHORTCUT = 1" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
    </Feature>
  </Package>
</Wix>
